# Copy to .env.local and fill in.
# Spotify dashboard redirect URI must be exactly:
#   http://127.0.0.1:3000/api/auth/callback/spotify
# Browse the dev server at http://127.0.0.1:3000 (not localhost),
# otherwise the session cookie won't match.
AUTH_URL=http://127.0.0.1:3000
AUTH_SECRET= # generate with: npx auth secret
AUTH_SPOTIFY_ID=
AUTH_SPOTIFY_SECRET=
